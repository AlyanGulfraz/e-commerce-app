<!-- File: app/src/main/res/layout/activity_login.xml -->
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="24dp"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView android:text="@string/login" android:textSize="24sp"
        android:layout_marginBottom="16dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <EditText android:id="@+id/email" android:hint="@string/email"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/password" android:hint="@string/password" android:inputType="textPassword"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <Button android:id="@+id/btnLogin" android:text="@string/login"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:layout_marginTop="8dp" android:text="@string/no_account"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/linkRegister" android:text="@string/register_here"
        android:textColor="@color/fwPrimaryText" android:layout_marginTop="4dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
