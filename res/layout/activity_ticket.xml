<!-- File: app/src/main/res/layout/activity_ticket.xml -->
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="8dp"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <!-- Ticket form -->
    <TextView android:text="@string/support_tickets" android:textSize="20sp"
        android:layout_marginBottom="8dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/ticketSubject" android:hint="@string/subject"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/ticketDescription" android:hint="@string/description"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/btnSubmitTicket" android:text="@string/submit_ticket"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <!-- List of tickets -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerTickets"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"/>
</LinearLayout>
